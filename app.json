{
  "expo": {
    "name": "Paycheck Planner",
    "slug": "paycheck-planner",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "paycheck-planner",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.johnhaup.paycheckplanner",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.johnhaup.paycheckplanner"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-font",
      [
        "expo-localization",
        {
          "supportedLocales": [
            "ar", "bn", "ca", "cs", "da", "de", "el", "en", "es", "fi",
            "fr", "gu", "he", "hi", "hr", "hu", "id", "it", "ja", "kn",
            "ko", "ml", "mr", "ms", "nl", "no", "or", "pa", "pl", "pt-BR",
            "pt-PT", "ro", "ru", "sk", "sl", "sv", "ta", "te", "th", "tr",
            "uk", "ur", "vi", "zh-Hans", "zh-Hant"
          ]
        }
      ],
      "./plugins/withoutPushEntitlement.js",
      [
        "expo-notifications",
        {
          "color": "#26de81"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "ccacheEnabled": true
          }
        }
      ],
      "expo-sharing",
      "expo-status-bar",
      "expo-iap",
      "./plugins/withStoreKitConfiguration.js"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "1628ead2-5166-4885-b0c8-baa6e8ee4486"
      }
    },
    "owner": "johnhaup"
  }
}
