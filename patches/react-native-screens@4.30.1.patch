@@ -83,6 +83,22 @@ namespace react = facebook::react;
 {
   [super viewDidLayoutSubviews];
 
+  // Paycheck Planner: content stops at a centred 600 pt column on a wide window (iPhone Duo unfolded, see
+  // src/hooks/useGutters.ts). UIKit places the bar's large title and buttons by the bar's safe area, not by layout
+  // margins, so the space beside the column is added to the safe area of this controller. `useGutters` reads the
+  // same safe area and keeps the content on the same edges.
+  // Measured in the superview: our own safe area already holds the insets set here.
+  UIView *host = self.view.superview;
+  CGFloat safeWidth =
+      CGRectIntersection(self.view.frame, UIEdgeInsetsInsetRect(host.bounds, host.safeAreaInsets)).size.width;
+  CGFloat columnMargin = self.navigationBarHidden ? 0 : MAX(0, (safeWidth - 600) / 2);
+  UIEdgeInsets columnInsets = self.additionalSafeAreaInsets;
+  if (columnInsets.left != columnMargin || columnInsets.right != columnMargin) {
+    columnInsets.left = columnMargin;
+    columnInsets.right = columnMargin;
+    self.additionalSafeAreaInsets = columnInsets;
+  }
+
